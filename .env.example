# Database
DATABASE_URL=postgresql://dev:devpass@localhost:5432/health_story_dev
# Vercel may only expose POSTGRES_URL — the app accepts either.

# Migrations run automatically before `next build` when a DB URL is set.
# Local `next build` without Postgres: SKIP_DB_MIGRATIONS=1
# Optional: use direct (non-pooling) URL for DDL on Vercel
# MIGRATE_DATABASE_URL=postgresql://...

# Vercel Blob (for file uploads in production / preview)
# Vercel dashboard → Storage → Blob → connect a store → copy Read-Write token
# Local dev: omit this to store uploads under public/photos/ (see src/lib/blob/upload.ts)
BLOB_READ_WRITE_TOKEN=

# NextAuth (if needed for advanced auth scenarios)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here

# Environment
NODE_ENV=development
